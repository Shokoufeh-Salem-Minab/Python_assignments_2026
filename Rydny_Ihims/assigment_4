import json

DATA_FILE = "gradebook.json"


class InvalidGradeError(Exception):
    pass


class StudentNotFoundError(Exception):
    pass


class Student:
    passing_grade = 10

    def __init__(self, student_id, name):
        self.student_id = student_id
        self.name = name
        self.grades = {}

    def add_grade(self, course, grade):
        if grade < 0 or grade > 20:
            raise InvalidGradeError("Grade must be between 0 and 20.")
        self.grades[course] = grade

    def average(self):
        if not self.grades:
            return 0
        return sum(self.grades.values()) / len(self.grades)

    def best_course(self):
        if not self.grades:
            return None, None
        course = max(self.grades, key=lambda c: self.grades[c])
        return course, self.grades[course]

    def to_dict(self):
        return {"type": "regular", "name": self.name, "grades": self.grades}

    def __str__(self):
        return f"[{self.student_id}] {self.name} | average: {self.average():.2f} | grades: {self.grades}"


class GraduateStudent(Student):
    passing_grade = 14

    def __init__(self, student_id, name, thesis_title):
        super().__init__(student_id, name)
        self.thesis_title = thesis_title

    def to_dict(self):
        data = super().to_dict()
        data["type"] = "graduate"
        data["thesis"] = self.thesis_title
        return data

    def __str__(self):
        return super().__str__() + f" | thesis: {self.thesis_title}"


class Gradebook:
    def __init__(self):
        self.students = {}

    def add_student(self, student):
        if student.student_id in self.students:
            raise ValueError("This student ID already exists.")
        self.students[student.student_id] = student

    def get_student(self, student_id):
        if student_id not in self.students:
            raise StudentNotFoundError(f"No student with ID {student_id}.")
        return self.students[student_id]

    def all_courses(self):
        courses = set()
        for student in self.students.values():
            courses.update(student.grades.keys())
        return courses

    def common_courses(self, id1, id2):
        s1 = self.get_student(id1)
        s2 = self.get_student(id2)
        return set(s1.grades) & set(s2.grades)

    def ranking(self):
        return sorted(self.students.values(), key=lambda s: s.average(), reverse=True)

    def failing_students(self):
        return [s for s in self.students.values() if s.grades and s.average() < s.passing_grade]

    def save(self):
        data = {sid: s.to_dict() for sid, s in self.students.items()}
        with open(DATA_FILE, "w") as f:
            json.dump(data, f, indent=4)

    def load(self):
        try:
            with open(DATA_FILE) as f:
                data = json.load(f)
        except (FileNotFoundError, json.JSONDecodeError):
            return
        for sid, info in data.items():
            if info["type"] == "graduate":
                student = GraduateStudent(sid, info["name"], info["thesis"])
            else:
                student = Student(sid, info["name"])
            student.grades = info["grades"]
            self.students[sid] = student

    def __len__(self):
        return len(self.students)


def read_grade():
    try:
        return float(input("Grade (0-20): "))
    except ValueError:
        raise InvalidGradeError("Grade must be a number.")


def add_student_menu(book):
    student_id = input("Student ID: ").strip()
    name = input("Name: ").strip()
    if not student_id or not name:
        raise ValueError("ID and name cannot be empty.")
    kind = input("Graduate student? (y/n): ").strip().lower()
    if kind == "y":
        thesis = input("Thesis title: ").strip()
        book.add_student(GraduateStudent(student_id, name, thesis))
    else:
        book.add_student(Student(student_id, name))
    print("Student added.")


def add_grade_menu(book):
    student = book.get_student(input("Student ID: ").strip())
    course = input("Course: ").strip()
    if not course:
        raise ValueError("Course name cannot be empty.")
    student.add_grade(course, read_grade())
    print("Grade saved.")


def show_students(book):
    if len(book) == 0:
        print("No students yet.")
        return
    for student in book.students.values():
        print(student)
        course, grade = student.best_course()
        if course:
            print(f"   best course: {course} ({grade})")
    print(f"Total students: {len(book)}")
    print("Courses offered:", ", ".join(sorted(book.all_courses())) or "none")


def show_ranking(book):
    for place, student in enumerate(book.ranking(), start=1):
        print(f"{place}. {student.name} - {student.average():.2f}")


def show_failing(book):
    failing = book.failing_students()
    if not failing:
        print("No failing students.")
    for student in failing:
        print(f"{student.name} - {student.average():.2f} (needs {student.passing_grade})")


def show_common(book):
    id1 = input("First student ID: ").strip()
    id2 = input("Second student ID: ").strip()
    common = book.common_courses(id1, id2)
    print("Common courses:", ", ".join(sorted(common)) if common else "none")


def print_menu():
    print("\n1. Add student")
    print("2. Add or update a grade")
    print("3. Show all students")
    print("4. Show ranking")
    print("5. Show failing students")
    print("6. Show common courses of two students")
    print("7. Save and exit")


def main():
    book = Gradebook()
    book.load()
    actions = {"1": add_student_menu, "2": add_grade_menu, "3": show_students,
               "4": show_ranking, "5": show_failing, "6": show_common}

    while True:
        print_menu()
        choice = input("Choose an option: ").strip()
        if choice == "7":
            book.save()
            print("Data saved. Bye!")
            break
        if choice not in actions:
            print("Invalid option, try again.")
            continue
        # any bad input lands here so the program keeps running
        try:
            actions[choice](book)
        except (InvalidGradeError, StudentNotFoundError, ValueError) as e:
            print("Error:", e)


if __name__ == "__main__":
    main()