first_name = "Canalp"
last_name = "Calik"

print("--- String Analysis ---")
print(f"First name length: {len(first_name)}")
print(f"Last name length: {len(last_name)}")

vowels = "aeiouAEIOU"
vowel_count = sum(1 for char in first_name if char in vowels)
print(f"Vowels in first name: {vowel_count}")

consonant_count = sum(1 for char in first_name if char.isalpha() and char not in vowels)
print(f"Consonants in first name: {consonant_count}")

print(f"Uppercase: {first_name.upper()}")
print(f"Lowercase: {first_name.lower()}")

print(f"Reversed last name: {last_name[::-1]}")

print("\n--- Loop Practice ---")
print("First name characters (for loop):")
for char in first_name:
    print(char, end=" ")
print()

print("First name characters (while loop removing characters):")
temp_name = first_name
while len(temp_name) > 0:
    print(temp_name)
    temp_name = temp_name[1:]

print("\n--- Conditions ---")
if len(first_name) > len(last_name):
    print("The first name is longer than the last name.")
elif len(first_name) < len(last_name):
    print("The first name is shorter than the last name.")
else:
    print("The first name and last name are equal in length.")

print("\n--- Generate a Personal Password ---")
total_chars = len(first_name) + len(last_name)
password = first_name[0] + last_name[-1] + str(total_chars)
print(f"Generated Password: {password}")

print("\n--- List Methods Practice ---")
char_list = list(last_name)
print(f"Original list: {char_list}")

char_list.append("*")
print(f"After .append('*'): {char_list}")

char_list.insert(0, "@")
print(f"After .insert(0, '@'): {char_list}")

char_list.pop()
print(f"After .pop(): {char_list}")

char_list.reverse()
print(f"After .reverse(): {char_list}") 
