class Student():
    def __init__(self, student):
        self.name = student["name"]
        self.exam1 = student["exam1"]
        self.exam2 = student["exam2"]
        self.exam3 = student["exam3"]
        self.homework = student["homework"]

    def exam_average(self):
        return (self.exam1 + self.exam2 + self.exam3)/3

    def homework_score(self):
        return (self.homework/10)*100

    def final_score(self):
        return (0.7*self.exam_average() + 0.3*self.homework_score())

    def status(self):
        if self.final_score() >= 60:
            return "Pass" 
        else:
            return "Fail"

    def excellent(self):
        if self.exam1 >= 90 and self.exam2 >= 90 and self.exam3 >= 90:
            return True
        else:
            return False

    def recovery_score(self):
        final = self.final_score()
        if final < 60:
            return min(final + 5, 100)
        else:
            return final

class Classroom():
    def __init__(self, students):
        self.students = [Student(student) for student in students]

    def class_average(self):
        return sum(student.final_score() for student in self.students) / len(self.students)

    def filter_students(self, filter):
        return [student for student in self.students if filter(student)]

    def rank_students(self):
        return sorted(self.students, key=lambda d: d.final_score(), reverse=True)

classroom = Classroom(students)

for student in classroom.rank_students():
    print(f"name: {student.name}, exam average: {student.exam_average()}, homework score: {student.homework_score()}, final score: {student.final_score()}, status: {student.status()}, excellent: {student.excellent()}, recovery score: {student.recovery_score()}")
print("Class average:", classroom.class_average())
print("Students with final score >= 80:", [student.name for student in classroom.filter_students(lambda s: s.final_score()>=80)])


