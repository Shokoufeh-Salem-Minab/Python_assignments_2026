def exam_average_fp(student):
    return (student["exam1"] + student["exam2"] + student["exam3"])/3

def homework_score_fp(student):
    return student["homework"]*10

def final_score_fp(student):
    return 0.7*exam_average_fp(student) + 0.3*homework_score_fp(student)

def calculation_fp(student):
    return ({**student, "exam_average": exam_average_fp(student), "homework_score": homework_score_fp(student), "final_score": final_score_fp(student), "status": "Pass" if final_score_fp(student) >= 60 else "Fail", "excellent": min(student["exam1"], student["exam2"], student["exam3"]) >= 90, "recovery_score": min(final_score_fp(student) + 5, 100)if final_score_fp(student) < 60 else final_score_fp(student)})

results_fp = list(map(calculation_fp, students))
passed_fp = list(filter(lambda s: s["final_score"] >= 60, results_fp))
ranked_fp = sorted(results_fp, key=lambda s: s["final_score"], reverse=True)
total_fp = reduce(lambda total, s: total + s["final_score"], results_fp, 0)

for student in ranked_fp:
    print(student["name"], student["final_score"], student["status"])

print("Class average:", total_fp / len(results_fp))
