def ask_text(prompt): 
    value = input(prompt).strip()
    if not value: 
        raise ValueError("Input cannot be empty")
    return value 

def ask_grade(prompt):
    try:
        grade = float(input(prompt))
    except ValueError:
        raise ValueError("Grade must be a number.") from None
    if not MIN_GRADE <= grade <= MAX_GRADE:
        raise InvalidGradeError(
            f"Grade must be between {MIN_GRADE} and {MAX_GRADE}.")
    return grade

def add_student_action(book): 
    kind = ask_text("Type - (r)egular or (g)raduate").lower()
    if kind not in ("r", "g"): 
        raise ValueError("Please enter 'r' or 'g' ")
    student_id = ask_text("Student ID: ")
